# Required secret NAMES only — NEVER commit real values.
# Copy to .env (gitignored) and fill in locally; in CI these come from GitHub Secrets.

# YNAB Personal Access Token — YNAB → Account Settings → Developer Settings → New Token
YNAB_PAT=

# YNAB budget UUID — YNAB app URL or GET /budgets via the API
YNAB_BUDGET_ID=

# Anthropic API key — Anthropic Console → API Keys
ANTHROPIC_API_KEY=

# --- Scheduled ingest (Gmail -> YNAB) ---
# Google OAuth client (Cloud Console -> Credentials) + one-time consent with gmail.readonly.
# The OAuth app MUST be published "In production" or the refresh token dies after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Card -> YNAB account mapping as ONE line of JSON (holds real YNAB account ids: keep it a
# secret, never commit it). Shape: {"entries":[{"bank":"bancolombia","last4":["8139","0338"],
# "ynabAccountId":"<uuid>"}],"productFallbacks":[{"bank":"bancolombia","product":"savings",
# "ynabAccountId":"<uuid>"}]}
# Optional "transferTargets": payees that are your OWN accounts (an alert that prints only the
# bank name, e.g. a card payment), posted as transfers:
#   ,"transferTargets":[{"counterparty":"Banco de Bogota","ynabAccountId":"<uuid>"}]
ACCOUNT_REGISTRY_JSON=

# Optional Rules Map (JSON): bank merchant text -> existing YNAB payee + category id. Holds your
# category ids, so keep it as a secret. Without it every row is written uncategorized.
# {"rules":[{"counterparty":"UBER","match":"prefix","payeeName":"Uber","categoryId":"<uuid>"}]}
# CATEGORY_RULES_JSON=

# Optional: Banco de Bogota sends everyday card alerts as SMS only. The owner's iPhone (a Shortcuts
# automation on messages from shortcode 85264 containing "Banco de Bogota:") mails each SMS to this
# Gmail mailbox with the subject SMSBDB. SMS_FORWARD_FROM lists the address(es) those mails come
# FROM (comma separated); only mail from them is read as an SMS alert. Unset = SMS ingest off.
# SMS_FORWARD_FROM=

# Optional operations channels (all off when unset):
#  - HEALTHCHECK_URL: healthchecks.io ping URL (dead-man's switch; alerts when runs stop).
#  - NTFY_TOPIC: your private ntfy topic (push for items needing review + the daily digest).
#    NTFY_SERVER defaults to https://ntfy.sh.
#  - GITHUB_TOKEN + GITHUB_REPOSITORY (owner/name): review-queue issues. Actions provides both.
# HEALTHCHECK_URL=
# NTFY_TOPIC=

# Optional: hours of Gmail history each run re-reads (default 72). Overlap is intentional.
# LOOKBACK_HOURS=72
