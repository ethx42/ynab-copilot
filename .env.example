# Required secret NAMES only — NEVER commit real values.
# Copy to .env (gitignored) and fill in locally; in CI these come from GitHub Secrets.

# YNAB Personal Access Token — YNAB → Account Settings → Developer Settings → New Token
YNAB_PAT=

# YNAB budget UUID — YNAB app URL or GET /budgets via the API
YNAB_BUDGET_ID=

# Anthropic API key — Anthropic Console → API Keys
ANTHROPIC_API_KEY=

# --- Scheduled ingest (Gmail -> YNAB) ---
# Google OAuth client (Cloud Console -> Credentials) + one-time consent with gmail.readonly.
# The OAuth app MUST be published "In production" or the refresh token dies after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Card -> YNAB account mapping as ONE line of JSON (holds real YNAB account ids: keep it a
# secret, never commit it). Shape: {"entries":[{"bank":"bancolombia","last4":["8139","0338"],
# "ynabAccountId":"<uuid>"}],"productFallbacks":[{"bank":"bancolombia","product":"savings",
# "ynabAccountId":"<uuid>"}]}
ACCOUNT_REGISTRY_JSON=

# Optional Rules Map (JSON): bank merchant text -> existing YNAB payee + category id. Holds your
# category ids, so keep it as a secret. Without it every row is written uncategorized.
# {"rules":[{"counterparty":"UBER","match":"prefix","payeeName":"Uber","categoryId":"<uuid>"}]}
# CATEGORY_RULES_JSON=

# Optional: hours of Gmail history each run re-reads (default 72). Overlap is intentional.
# LOOKBACK_HOURS=72
